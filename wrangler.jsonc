{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "holocron",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Vite plugin fills in `assets.directory` with the client build.
  // API and WebSocket routes reach the Worker first; everything else is the
  // single-page app, so deep links like /b/ABC123 load index.html.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },

  // One Durable Object per board. Its SQLite storage *is* the database.
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardObject"] }],

  // Board creation is rate limited per client IP. So is looking boards up
  // (meta, export, socket), which slows down anyone guessing codes; the
  // limit leaves room for a whole team joining from one office address.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "PROBE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],

  // When every board is wiped. Self-hosters: change these and redeploy.
  // RESET_HOUR is 0–23 in RESET_TZ (an IANA time zone name).
  "vars": {
    "RESET_TZ": "America/New_York",
    "RESET_HOUR": "6",
    // Optional Turnstile check on board creation. Off while empty. To turn
    // it on, put the widget's site key here and its secret in a Worker
    // secret: `npx wrangler secret put TURNSTILE_SECRET_KEY`. See
    // docs/self-hosting.md.
    "TURNSTILE_SITE_KEY": ""
  },

  "observability": { "enabled": true }
}
